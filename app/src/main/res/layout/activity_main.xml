<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ================= 1. TAB MÁY ẢNH (CAMERA VIEW) ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraTabContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationPill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Camera Preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:scaleType="fillCenter" />

        <!-- AI Composition Guide Overlay (Vẽ AR lưới 1/3, target vàng, mũi tên, thước chân trời, vòng điểm góc phải) -->
        <com.dinh.aicamera.overlay.CompositionOverlayView
            android:id="@+id/compositionOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TOP BAR: Floating Glass Pill bo tròn hoàn toàn, không full-width, căn giữa phía trên, các nút bấm cực nhạy -->
        <LinearLayout
            android:id="@+id/topToolbar"
            style="@style/Widget.LievisCam.GlassPill"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Nút Bật/Tắt AI (Icon đổi trạng thái rõ ràng) -->
            <ImageButton
                android:id="@+id/btnAiToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_mode_off"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sparkles"
                app:tint="@color/white_50" />

            <!-- Nút Bật/Tắt Lưới 1/3 riêng biệt -->
            <ImageButton
                android:id="@+id/btnGridToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/grid_off"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_grid"
                app:tint="@color/white_50" />

            <!-- Nút Đổi Flash -->
            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/flash_auto"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_flash_auto" />

            <!-- Nút Chọn Filter -->
            <ImageButton
                android:id="@+id/btnFilterToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/filter_none"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_filter"
                app:tint="@color/white" />

            <!-- Nút Đổi Camera Trước/Sau -->
            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_camera_flip" />

            <!-- Nút Cài đặt -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cài đặt"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Pill "AI gợi ý filter" (Đặt ở phía dưới trên thanh chụp, KHÔNG ĐÈ lên vòng điểm số ở góc trên) -->
        <LinearLayout
            android:id="@+id/aiSuggestionBubble"
            style="@style/Widget.LievisCam.GlassPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="7dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/filterCarouselScroll"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkles" />

            <TextView
                android:id="@+id/tvAiSuggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/accent_pink"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="AI gợi ý: Filter Sáng (Khung hình tối)" />
        </LinearLayout>

        <!-- Filter Selection Carousel (Floating glass container bo tròn) -->
        <HorizontalScrollView
            android:id="@+id/filterCarouselScroll"
            style="@style/Widget.LievisCam.GlassPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:scrollbars="none"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/zoomPresetContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/filterChipContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Hàng nút preset zoom (0.5x, 1x, 3x, 6x) kiểu Liquid Glass pill + text mức zoom realtime -->
        <LinearLayout
            android:id="@+id/zoomPresetContainer"
            style="@style/Widget.LievisCam.GlassPill"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            app:layout_constraintBottom_toTopOf="@id/shutterSection"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/btnZoom05"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="0.5x"
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_pill_active"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="1x"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom3"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="3x"
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom6"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="6x"
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/zoomDivider"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/glass_stroke" />

            <TextView
                android:id="@+id/tvCurrentZoom"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="34dp"
                android:paddingHorizontal="6dp"
                android:text="1.0x"
                android:textColor="@color/accent_pink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Shutter Section (Nút chụp luôn chụp ngay không delay) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/shutterSection"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Thumbnail xem nhanh thư viện -->
            <FrameLayout
                android:id="@+id/btnQuickPreview"
                style="@style/Widget.LievisCam.GlassCircle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivQuickThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/gallery_title"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_gallery" />
            </FrameLayout>

            <!-- Main Shutter Button -->
            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_shutter_outer"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:id="@+id/shutterInnerCircle"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter_inner" />
            </FrameLayout>

            <!-- Auto-Capture Indicator Status Pill (Chỉ hiện khi AI đang BẬT) -->
            <LinearLayout
                android:id="@+id/autoCaptureBadge"
                style="@style/Widget.LievisCam.GlassPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnTools"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:id="@+id/autoCaptureDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_glass_circle"
                    android:backgroundTint="@color/score_green" />

                <TextView
                    android:id="@+id/tvAutoCaptureStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="AUTO"
                    android:textColor="@color/white_90"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nút Tools (3 chấm ngang) -->
            <ImageButton
                android:id="@+id/btnTools"
                style="@style/Widget.LievisCam.GlassCircle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Công cụ"
                android:src="@drawable/ic_more_horiz"
                app:tint="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= 2. TAB THƯ VIỆN RIÊNG (DEDICATED GALLERY) ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/galleryTabContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationPill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:id="@+id/galleryTopBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvGalleryTabTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gallery_title"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGalleryCount"
                style="@style/Widget.LievisCam.GlassPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="@color/accent_pink"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="14 ảnh" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGalleryGrid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/galleryTopBar" />

        <ProgressBar
            android:id="@+id/galleryLoadingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/accent_pink"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/galleryTopBar" />

        <TextView
            android:id="@+id/tvEmptyGallery"
            style="@style/Widget.LievisCam.GlassPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/gallery_empty"
            android:textColor="@color/white_70"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/galleryTopBar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= 3. FLOATING BOTTOM TAB PILL ================= -->
    <LinearLayout
        android:id="@+id/bottomNavigationPill"
        style="@style/Widget.LievisCam.GlassPill"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tabBtnCamera"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_pill_active"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="@string/tab_camera"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabBtnGallery"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="@string/tab_gallery"
            android:textColor="@color/white_70"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- Permission Request Overlay Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/permissionCard"
        style="@style/Widget.LievisCam.GlassDialog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/ivPermIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_camera_flip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/accent_pink" />

        <TextView
            android:id="@+id/tvPermTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivPermIcon" />

        <TextView
            android:id="@+id/tvPermDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/camera_permission_rationale"
            android:textColor="@color/white_70"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPermTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            style="@style/Widget.LievisCam.GlassPill.Active"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:paddingHorizontal="28dp"
            android:text="@string/permission_grant_btn"
            android:textColor="@color/accent_pink"
            android:textStyle="bold"
            app:cornerRadius="999dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPermDesc" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
