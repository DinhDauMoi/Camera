<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.LievisCam.GlassDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <!-- Top Handle Bar -->
    <View
        android:id="@+id/handleBar"
        style="@style/Widget.LievisCam.GlassPill"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:backgroundTint="@color/white_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title & Close -->
    <TextView
        android:id="@+id/tvToolsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Công cụ"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnCloseTools"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/handleBar" />

    <ImageButton
        android:id="@+id/btnCloseTools"
        style="@style/Widget.LievisCam.GlassCircle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="Đóng"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/tvToolsTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvToolsTitle" />

    <!-- 1. Histogram -->
    <LinearLayout
        android:id="@+id/rowHistogram"
        style="@style/Widget.LievisCam.GlassPill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvToolsTitle">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Histogram realtime"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHistogram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/accent_pink"
            app:trackTint="@color/white_20" />
    </LinearLayout>

    <!-- 2. Pose guide -->
    <LinearLayout
        android:id="@+id/rowPoseGuide"
        style="@style/Widget.LievisCam.GlassPill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowHistogram">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Khung mẫu dáng (Pose guide)"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPoseGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/accent_pink"
            app:trackTint="@color/white_20" />
    </LinearLayout>

    <!-- 3. AI học gu -->
    <LinearLayout
        android:id="@+id/rowTasteLearning"
        style="@style/Widget.LievisCam.GlassPill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowPoseGuide">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI học gu bố cục"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchTasteLearning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/accent_pink"
            app:trackTint="@color/white_20" />
    </LinearLayout>

    <!-- 4. Nhắc giờ vàng -->
    <LinearLayout
        android:id="@+id/rowGoldenHour"
        style="@style/Widget.LievisCam.GlassPill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowTasteLearning">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nhắc nhở giờ vàng"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchGoldenHour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/accent_pink"
            app:trackTint="@color/white_20" />
    </LinearLayout>

    <!-- 5. Thước cân bằng -->
    <LinearLayout
        android:id="@+id/rowLevel"
        style="@style/Widget.LievisCam.GlassPill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowGoldenHour">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thước cân bằng chân trời"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/accent_pink"
            app:trackTint="@color/white_20" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
