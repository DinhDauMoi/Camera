<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.LievisCam.GlassDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="20dp"
    android:paddingBottom="28dp"
    android:paddingHorizontal="16dp">

    <!-- Top Handle Bar -->
    <View
        android:id="@+id/handleBar"
        style="@style/Widget.LievisCam.GlassPill"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:backgroundTint="@color/white_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title & Close -->
    <TextView
        android:id="@+id/tvToolsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="4dp"
        android:text="Công cụ"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnCloseTools"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/handleBar" />

    <ImageButton
        android:id="@+id/btnCloseTools"
        style="@style/Widget.LievisCam.GlassCircle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="Đóng"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/tvToolsTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvToolsTitle" />

    <!-- 5 Tools Horizontal Row -->
    <HorizontalScrollView
        android:id="@+id/scrollTools"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvToolsTitle">

        <LinearLayout
            android:id="@+id/layoutToolsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 1. Histogram realtime -->
            <LinearLayout
                android:id="@+id/itemToolHistogram"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolHistogram"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:elevation="0dp"
                    app:strokeWidth="0dp"
                    app:cornerRadius="999dp"
                    android:checkable="true"
                    app:iconSize="26dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/btn_tool_bg_selector"
                    app:iconTint="@color/btn_tool_icon_selector"
                    app:icon="@drawable/ic_histogram" />

                <TextView
                    android:id="@+id/tvToolHistogram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:textSize="11sp"
                    android:textColor="@color/white_70"
                    android:text="Histogram\nrealtime" />
            </LinearLayout>

            <!-- 2. Pose guide -->
            <LinearLayout
                android:id="@+id/itemToolPoseGuide"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolPoseGuide"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:elevation="0dp"
                    app:strokeWidth="0dp"
                    app:cornerRadius="999dp"
                    android:checkable="true"
                    app:iconSize="26dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/btn_tool_bg_selector"
                    app:iconTint="@color/btn_tool_icon_selector"
                    app:icon="@drawable/ic_pose_guide" />

                <TextView
                    android:id="@+id/tvToolPoseGuide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:textSize="11sp"
                    android:textColor="@color/white_70"
                    android:text="Pose\nguide" />
            </LinearLayout>

            <!-- 3. AI học gu -->
            <LinearLayout
                android:id="@+id/itemToolTasteLearning"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolTasteLearning"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:elevation="0dp"
                    app:strokeWidth="0dp"
                    app:cornerRadius="999dp"
                    android:checkable="true"
                    app:iconSize="26dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/btn_tool_bg_selector"
                    app:iconTint="@color/btn_tool_icon_selector"
                    app:icon="@drawable/ic_sparkles" />

                <TextView
                    android:id="@+id/tvToolTasteLearning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:textSize="11sp"
                    android:textColor="@color/white_70"
                    android:text="AI học\ngu" />
            </LinearLayout>

            <!-- 4. Nhắc giờ vàng -->
            <LinearLayout
                android:id="@+id/itemToolGoldenHour"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolGoldenHour"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:elevation="0dp"
                    app:strokeWidth="0dp"
                    app:cornerRadius="999dp"
                    android:checkable="true"
                    app:iconSize="26dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/btn_tool_bg_selector"
                    app:iconTint="@color/btn_tool_icon_selector"
                    app:icon="@drawable/ic_golden_hour" />

                <TextView
                    android:id="@+id/tvToolGoldenHour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:textSize="11sp"
                    android:textColor="@color/white_70"
                    android:text="Nhắc\ngiờ vàng" />
            </LinearLayout>

            <!-- 5. Thước cân bằng -->
            <LinearLayout
                android:id="@+id/itemToolLevel"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolLevel"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:elevation="0dp"
                    app:strokeWidth="0dp"
                    app:cornerRadius="999dp"
                    android:checkable="true"
                    app:iconSize="26dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/btn_tool_bg_selector"
                    app:iconTint="@color/btn_tool_icon_selector"
                    app:icon="@drawable/ic_level" />

                <TextView
                    android:id="@+id/tvToolLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:textSize="11sp"
                    android:textColor="@color/white_70"
                    android:text="Thước\ncân bằng" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
