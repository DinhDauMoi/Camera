<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Viền kính 1dp gradient khúc xạ ánh sáng (bo tròn 24dp) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="#80FFFFFF"
                android:centerColor="#55FFFFFF"
                android:endColor="#26FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <!-- Nền kính trong suốt + highlight phản chiếu mỏng phía trên -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#2BFFFFFF"
                android:centerColor="#1CFFFFFF"
                android:endColor="#260A0D14"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
